# Ephemeral Chat & Dating - Environment Configuration

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# PostgreSQL Database (DO NOT USE SQLITE - PostgreSQL is required everywhere)
DATABASE_URL=postgresql://pk@localhost:5432/ephemeral_chat_db
TEST_DATABASE_URL=postgresql://pk@localhost:5432/ephemeral_chat_test_db

# Media Storage
STORAGE_BACKEND=local
STORAGE_DIR=/Users/pk/Desktop/chatapp/storage

# Message and Media Retention (in seconds/days)
MESSAGE_RETENTION_DAYS=7
EPHEMERAL_IMAGE_VIEW_TIMEOUT_SECONDS=60

# Rate Limiting
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://

# Security Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=604800

# Admin Seed Account (Optional initialization)
ADMIN_EMAIL=admin@ephemeral.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePassword123!
